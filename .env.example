# Copy to .env.local and fill in for local work against the Neon dev branch (never production).
# README.md, "Local setup", says where the dev values live and which is which.

# Database and auth
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
ORIGIN_VERIFY_SECRET=
HEALTH_TOKEN=

# App and email
NEXT_PUBLIC_APP_URL=
APP_ENV=
NON_PROD_MAIL_TO=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Demo seed (scripts/seed-demo.ts)
DEMO_DATABASE_URL=

# End-to-end tests (Playwright)
E2E_BASE_URL=
E2E_DATABASE_URL=
E2E_APP_DATABASE_URL=
E2E_RUN_ID=

# Database contract tests (scripts/test-db.sh sets these for its Docker database)
TEST_APP_URL=
TEST_AUTH_URL=
TEST_OWNER_URL=
